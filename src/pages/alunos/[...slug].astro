---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Pesquisador from '../../layouts/Pesquisador.astro';
import RootLayout from '../../layouts/RootLayout.astro'
import {  } from '@orgajs/astro'

export async function getStaticPaths() {
	const alunos = await getCollection('pesquisadores');
	return alunos.map((aluno) => ({
		params: { slug: aluno.id },
		props: aluno,
	}));
}
type Props = CollectionEntry<'pesquisadores'>;

const aluno = Astro.props;
const { Content } = await render(aluno);
---
<RootLayout>
	<Pesquisador {...aluno.data}>
		<Content />
	</Pesquisador>
	{JSON.stringify(aluno)}
</RootLayout>
