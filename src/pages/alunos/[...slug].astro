---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Pesquisador from '../../layouts/Pesquisador.astro';
import RootLayout from '../../layouts/RootLayout.astro'

const orgFiles = import.meta.glob('/src/content/pesquisadores/*.org');

export async function getStaticPaths() {
	const alunos = await getCollection('pesquisadores');
	return alunos.map((aluno) => ({
		params: { slug: aluno.slug },
		props: aluno,
	}));
}
type Props = CollectionEntry<'pesquisadores'>;

const aluno = Astro.props;
let Content: any;
if (aluno.filePath?.endsWith('.org')) {
	const mod = await orgFiles[`/${aluno.filePath}`]() as any;
	Content = mod.default;
} else {
	({ Content } = await render(aluno));
}
---
<RootLayout>
	<Pesquisador {...aluno.data}>
		<Content />
	</Pesquisador>
	{JSON.stringify(aluno)}

</RootLayout>
